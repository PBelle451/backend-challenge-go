# Copie para .env antes de subir o ambiente:  cp .env.example .env
# Valores locais de exemplo. Nenhum segredo real aqui.

# --- PostgreSQL ---
POSTGRES_USER=wager
POSTGRES_PASSWORD=wager_local_pw
POSTGRES_DB=wager
POSTGRES_PORT=5432

# --- Keycloak (IdP OAuth 2.0 / OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_pw
KEYCLOAK_PORT=8081

# --- LocalStack (SQS) ---
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
# Credenciais fictícias exigidas pelo SDK da AWS (o LocalStack aceita qualquer valor)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Aplicação (usadas nas próximas etapas) ---
APP_HTTP_PORT=8080
DATABASE_URL=postgres://wager:wager_local_pw@localhost:5432/wager?sslmode=disable

OIDC_ISSUER_URL=http://localhost:8081/realms/wager
OIDC_JWKS_URL=http://localhost:8081/realms/wager/protocol/openid-connect/certs
OIDC_AUDIENCE=wager-service

SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
